diff --git a/tests/test_philter_mcp.py b/tests/test_philter_mcp.py
index d1327ec..da4bd41 100644
--- a/tests/test_philter_mcp.py
+++ b/tests/test_philter_mcp.py
@@ -162,3 +162,59 @@ def test_status_falls_back_to_text():
 
     client = PhilterClient(base_url="http://philter.test", transport=httpx.MockTransport(handler))
     assert asyncio.run(client.status()) == {"status": "HEALTHY"}
+
+
+# --- Philter 4.x: /api/health and contexts created on first use ---------------
+
+def test_status_uses_health_endpoint_on_philter_4():
+    seen = []
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        seen.append((request.method, request.url.path))
+        if request.url.path == "/api/health":
+            return httpx.Response(200, json={"status": "UP", "applicationVersion": "4.0.1"})
+        return httpx.Response(404)
+
+    client = PhilterClient(base_url="http://philter.test", transport=httpx.MockTransport(handler))
+    assert asyncio.run(client.status())["status"] == "UP"
+    assert seen == [("GET", "/api/health")]
+
+
+def test_explain_creates_missing_context_once():
+    created = []
+    contexts = {"default"}
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        path = request.url.path
+        if path.startswith("/api/contexts/"):
+            name = path.rsplit("/", 1)[1]
+            return httpx.Response(200 if name in contexts else 404, json={})
+        if path == "/api/contexts" and request.method == "POST":
+            import json as _json
+            name = _json.loads(request.content)["name"]
+            contexts.add(name)
+            created.append(name)
+            return httpx.Response(201, json={"message": "Context created."})
+        if path == "/api/explain":
+            if request.url.params.get("c") not in contexts:
+                return httpx.Response(400)
+            return httpx.Response(200, json=EXPLAIN_RESPONSE)
+        return httpx.Response(404)
+
+    client = PhilterClient(base_url="http://philter.test", transport=httpx.MockTransport(handler))
+    asyncio.run(client.explain("hi", context="demo"))
+    asyncio.run(client.explain("hi", context="demo"))
+    asyncio.run(client.explain("hi", context="default"))
+    assert created == ["demo"]
+
+
+def test_explain_context_conflict_is_ok():
+    def handler(request: httpx.Request) -> httpx.Response:
+        if request.url.path.startswith("/api/contexts/"):
+            return httpx.Response(404)
+        if request.url.path == "/api/contexts":
+            return httpx.Response(409, json={"reason": "context_exists"})
+        return httpx.Response(200, json=EXPLAIN_RESPONSE)
+
+    client = PhilterClient(base_url="http://philter.test", transport=httpx.MockTransport(handler))
+    assert asyncio.run(client.explain("hi", context="race"))["documentId"]
